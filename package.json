{
  "name": "ng-micro-frontends",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:all",
    "start:all": "concurrently -k -n shell,products,cart -c blue,magenta,green \"npm:start:shell\" \"npm:start:products\" \"npm:start:cart\"",
    "start:shell": "ng serve shell --port 4220",
    "start:products": "ng serve products-remote --port 4221",
    "start:cart": "ng serve cart-remote --port 4222",
    "build": "ng build shell && ng build products-remote && ng build cart-remote",
    "watch": "ng build --watch --configuration development",
    "test": "ng test shell"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular-architects/native-federation": "~22.2.5",
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/forms": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/router": "~22.2.0",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.0",
    "@angular/cli": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "@softarc/native-federation-orchestrator": "^4.10.0",
    "concurrently": "^10.0.7",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.0",
    "vitest": "^4.0.8"
  }
}
